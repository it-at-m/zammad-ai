{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Renovate config for it-at-m / KICC",
  extends: [
    "config:best-practices", // best practices
    "customManagers:githubActionsVersions", // manages _VERSION variables in GitHub Action workflows
    "helpers:pinGitHubActionDigestsToSemver", // pin to digest with semver as comment
    ":pinAllExceptPeerDependencies", // pin all dependencies except peer dependencies
    "schedule:weekly", // only weekly updates
    ":separateMultipleMajorReleases", // separate major updates of dependencies into separate PRs
    ":timezone(Europe/Berlin)", // sets correct timezone for schedule based operations
    "security:openssf-scorecard", // show OpenSSF badge on pull requests to evaluate security health metrics for dependencies
    ":automergeMinor", // automerge minor and patch releases
    ":prConcurrentLimit10" // 10 open PRs at max
  ],
  labels: ["renovate"],
  lockFileMaintenance: {
    enabled: true,
  },
  reviewers: ["nharbig", "pilitz"],
  packageRules: [
    {
      // Python 3.15 is not yet widely supported (e.g. onnxruntime ships no cp315 wheels).
      // Allow 3.14.x patch updates only; block minor bumps like 3.15 for the time being.
      matchDepNames: ["python"],
      allowedVersions: "<3.15",
    },
    {
      // langchain-xberg 1.4.0 requires xberg>=1.4.0,<2, but xberg 1.4.0 was never
      // published (PyPI latest: 1.3.9), making langchain-xberg 1.4.0 unresolvable.
      // Remove this rule once xberg 1.4.0 is available on PyPI.
      matchDepNames: ["langchain-xberg"],
      allowedVersions: "<1.4",
    },
    {
      matchManagers: ["pep621"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Python: non-major updates",
      groupSlug: "python-non-major",
      matchDepNames: ["!python"],
    },
    {
      matchManagers: ["dockerfile"],
      groupName: "Dockerfile base images",
      groupSlug: "dockerfile-base-images",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions dependencies",
      groupSlug: "github-actions",
    },
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "npm: non-major updates",
      groupSlug: "npm-non-major",
    },
  ],
}
